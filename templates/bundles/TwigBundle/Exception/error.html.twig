{% extends 'base.html.twig' %}

{% block title %}Erreur - {{ status_code }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-template">
                <h1 class="display-1 text-secondary">{{ status_code }}</h1>
                <h2 class="mb-4">Une erreur s'est produite</h2>
                <div class="error-details mb-4">
                    <p class="lead">{{ status_text }}</p>
                    {% if app.environment == 'dev' %}
                        <div class="alert alert-info mt-3">
                            <strong>Mode développement :</strong> {{ exception.message }}
                        </div>
                    {% endif %}
                </div>
                <div class="error-actions">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg me-2">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                    {% if app.user %}
                        <a href="{{ path('partie_index') }}" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-list"></i> Mes parties
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

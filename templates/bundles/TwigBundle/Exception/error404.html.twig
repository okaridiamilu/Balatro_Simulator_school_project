{% extends 'base.html.twig' %}

{% block title %}Page non trouvée - 404{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-template">
                <h1 class="display-1 text-primary">404</h1>
                <h2 class="mb-4">Page non trouvée</h2>
                <div class="error-details mb-4">
                    <p class="lead">Désolé, la page que vous recherchez n'existe pas ou a été déplacée.</p>
                </div>
                <div class="error-actions">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg me-2">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                    {% if app.user %}
                        <a href="{{ path('partie_index') }}" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-list"></i> Mes parties
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

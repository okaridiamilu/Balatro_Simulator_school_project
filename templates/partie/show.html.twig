{% extends "base.html.twig" %}

{% block title %}{{ partie.identifiant }} - BALATRO SIMULATOR{% endblock %}

{% block body %}
<div style="margin-bottom: 20px;">
    <a href="{{ path('partie_index') }}" style="color: #007bff; text-decoration: none;">
        ← Retour aux parties
    </a>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1 style="margin: 0;">🎲 {{ partie.identifiant }}</h1>
    <div style="display: flex; gap: 10px;">
        <a href="{{ path('partie_cartes_index', {'partieId': partie.id}) }}" 
           style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            🃏 Deck ({{ partie.cartes|length }})
        </a>
        <a href="{{ path('partie_consommables_index', {'partieId': partie.id}) }}" 
           style="background-color: #6f42c1; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            🔮 Consommables ({{ partie.consommables|length }})
        </a>
        <a href="{{ path('hand_levels_index', {'partieId': partie.id}) }}" 
           style="background-color: #17a2b8; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            📊 Hand Levels
        </a>
    </div>
</div>

{# Messages flash #}
{% for message in app.flashes('success') %}
    <div style="background-color: #28a745; color: white; padding: 15px; border-radius: 5px; margin: 15px 0;">
        ✅ {{ message }}
    </div>
{% endfor %}

{# Informations de la partie #}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 30px 0;">
    <div style="background-color: #ffc107; color: #000; padding: 20px; border-radius: 10px; text-align: center;">
        <div style="font-size: 2em;">💰</div>
        <div style="font-size: 1.5em; font-weight: bold;">{{ partie.money }}$</div>
        <div style="font-size: 0.9em;">Argent</div>
        <div style="margin-top: 10px;">
            <a href="{{ path('partie_money_update', {'id': partie.id, 'amount': 10}) }}" 
               style="background-color: #28a745; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                +10$
            </a>
            <a href="{{ path('partie_money_update', {'id': partie.id, 'amount': -10}) }}" 
               style="background-color: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                -10$
            </a>
        </div>
    </div>
    
    <div style="background-color: #007bff; color: white; padding: 20px; border-radius: 10px; text-align: center;">
        <div style="font-size: 2em;">🃏</div>
        <div style="font-size: 1.5em; font-weight: bold;">{{ partie.hand }}</div>
        <div style="font-size: 0.9em;">Cartes en main</div>
        <div style="margin-top: 10px;">
            <a href="{{ path('partie_hand_update', {'id': partie.id, 'amount': 1}) }}" 
               style="background-color: #28a745; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                +1
            </a>
            <a href="{{ path('partie_hand_update', {'id': partie.id, 'amount': -1}) }}" 
               style="background-color: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                -1
            </a>
        </div>
    </div>
    
    <div style="background-color: #6c757d; color: white; padding: 20px; border-radius: 10px; text-align: center;">
        <div style="font-size: 2em;">🗑️</div>
        <div style="font-size: 1.5em; font-weight: bold;">{{ partie.discard }}</div>
        <div style="font-size: 0.9em;">Défausses</div>
        <div style="margin-top: 10px;">
            <a href="{{ path('partie_discard_update', {'id': partie.id, 'amount': 1}) }}" 
               style="background-color: #28a745; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                +1
            </a>
            <a href="{{ path('partie_discard_update', {'id': partie.id, 'amount': -1}) }}" 
               style="background-color: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                -1
            </a>
        </div>
    </div>
    
    <div style="background-color: #17a2b8; color: white; padding: 20px; border-radius: 10px; text-align: center;">
        <div style="font-size: 2em;">🤡</div>
        <div style="font-size: 1.5em; font-weight: bold;">
            {{ partie.jokers|length }}/{{ partie.totalJokerSlots }}
        </div>
        <div style="font-size: 0.9em;">Slots Jokers</div>
        <div style="margin-top: 10px;">
            <a href="{{ path('partie_joker_slots_update', {'id': partie.id, 'amount': 1}) }}" 
               style="background-color: #28a745; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                +1
            </a>
            <a href="{{ path('partie_joker_slots_update', {'id': partie.id, 'amount': -1}) }}" 
               style="background-color: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;">
                -1
            </a>
        </div>
    </div>
    
    <div style="background-color: {% if partie.observatoireActif %}#9b59b6{% else %}#34495e{% endif %}; color: white; padding: 20px; border-radius: 10px; text-align: center;">
        <div style="font-size: 2em;">🔭</div>
        <div style="font-size: 1.5em; font-weight: bold;">Observatoire</div>
        <div style="font-size: 0.9em;">
            {% if partie.observatoireActif %}
                ✅ Activé
            {% else %}
                ⚪ Désactivé
            {% endif %}
        </div>
        <form method="post" action="{{ path('partie_toggle_observatoire', {'id': partie.id}) }}" style="margin-top: 10px;">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_observatoire_' ~ partie.id) }}">
            <button type="submit" style="background-color: {% if partie.observatoireActif %}#e74c3c{% else %}#27ae60{% endif %}; color: white; padding: 8px 16px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                {% if partie.observatoireActif %}
                    Désactiver
                {% else %}
                    Activer
                {% endif %}
            </button>
        </form>
    </div>
</div>

<hr style="margin: 40px 0;">

{# Mes Jokers #}
<h2>🤡 Mes Jokers ({{ partie.jokers|length }}/{{ partie.totalJokerSlots }})</h2>

{% if partie.jokers|length > 0 %}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin: 20px 0;">
        {% for jokerInstance in partie.jokers %}
            <div style="border: 2px solid #ddd; border-radius: 10px; padding: 15px; background-color: white; box-shadow: 2px 2px 10px rgba(0,0,0,0.1);">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                    <h3 style="margin: 0 0 10px 0; color: #333;">
                        {{ jokerInstance.jokerTemplate.nom }}
                        {% if jokerInstance.etat %}
                            {% if jokerInstance.etat.value == 'foil' %}
                                ✨
                            {% elseif jokerInstance.etat.value == 'polychrome' %}
                                🌈
                            {% elseif jokerInstance.etat.value == 'holographique' %}
                                💎
                            {% elseif jokerInstance.etat.value == 'negatif' %}
                                ⚫
                            {% endif %}
                        {% endif %}
                    </h3>
                    <span style="background-color: #e9ecef; padding: 3px 8px; border-radius: 3px; font-size: 0.9em;">
                        #{{ jokerInstance.ordre }}
                    </span>
                </div>
                
                {% if jokerInstance.etat %}
                    <p style="margin: 5px 0; font-size: 0.9em;">
                        <strong>État :</strong> 
                        <span style="background-color: #ffc107; padding: 2px 6px; border-radius: 3px;">
                            {{ jokerInstance.etat.value|capitalize }}
                        </span>
                    </p>
                {% endif %}
                
                <p style="margin: 5px 0;">
                    <strong>Rareté :</strong>
                    <span style="
                        padding: 2px 6px; 
                        border-radius: 3px; 
                        color: white;
                        font-size: 0.9em;
                        {% if jokerInstance.jokerTemplate.rarete.value == 'commun' %}
                            background-color: #6c757d;
                        {% elseif jokerInstance.jokerTemplate.rarete.value == 'uncommun' %}
                            background-color: #28a745;
                        {% elseif jokerInstance.jokerTemplate.rarete.value == 'rare' %}
                            background-color: #007bff;
                        {% elseif jokerInstance.jokerTemplate.rarete.value == 'legendary' %}
                            background-color: #ffc107; color: #000;
                        {% endif %}
                    ">
                        {{ jokerInstance.jokerTemplate.rarete.value|upper }}
                    </span>
                </p>
                
                <p style="font-style: italic; color: #666; margin: 10px 0; font-size: 0.9em;">
                    {{ jokerInstance.jokerTemplate.description }}
                </p>
                
                {% if jokerInstance.hasManualStack %}
                    <div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin: 10px 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin: 5px 0;">
                            <div style="font-size: 0.9em;">
                                <strong>Stacks :</strong> {{ jokerInstance.compteurStack }}
                            </div>
                            <div style="display: flex; gap: 5px;">
                                <form method="post" action="{{ path('partie_joker_stack_update', {partieId: partie.id, jokerId: jokerInstance.id, amount: -1}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('joker_stack_update_' ~ jokerInstance.id) }}">
                                    <button type="submit" 
                                            style="background-color: #dc3545; color: white; padding: 3px 10px; border: none; border-radius: 3px; cursor: pointer; font-weight: bold;"
                                            {% if jokerInstance.compteurStack == 0 %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
                                        -1
                                    </button>
                                </form>
                                <form method="post" action="{{ path('partie_joker_stack_update', {partieId: partie.id, jokerId: jokerInstance.id, amount: 1}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('joker_stack_update_' ~ jokerInstance.id) }}">
                                    <button type="submit" 
                                            style="background-color: #28a745; color: white; padding: 3px 10px; border: none; border-radius: 3px; cursor: pointer; font-weight: bold;">
                                        +1
                                    </button>
                                </form>
                            </div>
                        </div>
                        <p style="margin: 5px 0; font-size: 0.9em;">
                            <strong>Effet total :</strong> 
                            {% set total = jokerInstance.effetTotal %}
                            {% if jokerInstance.jokerTemplate.typeStack.value == 'chips' %}
                                +{{ total }} Chips 🪙
                            {% elseif jokerInstance.jokerTemplate.typeStack.value == 'mult_flat' %}
                                +{{ total }} Mult ✖️
                            {% elseif jokerInstance.jokerTemplate.typeStack.value == 'mult_multiplicateur' %}
                                x{{ total }} Mult 📈
                            {% elseif jokerInstance.jokerTemplate.typeStack.value == 'xmult' %}
                                x{{ total }} Mult 💥
                            {% endif %}
                        </p>
                    </div>
                {% else %}
                    <div style="background-color: #e7f3ff; padding: 10px; border-radius: 5px; margin: 10px 0; border-left: 3px solid #007bff;">
                        <p style="margin: 0; font-size: 0.85em; color: #0056b3; font-style: italic;">
                            ⚡ Effet conditionnel - S'applique pendant le jeu
                        </p>
                    </div>
                {% endif %}
                
                <a href="{{ path('partie_joker_delete', {'partieId': partie.id, 'jokerId': jokerInstance.id}) }}" 
                   onclick="return confirm('Retirer ce joker de la partie ?');"
                   style="display: block; text-align: center; padding: 8px; background-color: #dc3545; color: white; text-decoration: none; border-radius: 5px; margin-top: 10px;">
                    🗑️ Retirer
                </a>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div style="background-color: #e9ecef; padding: 20px; border-radius: 5px; margin: 20px 0; text-align: center;">
        <p style="margin: 0; color: #666;">
            Aucun joker dans cette partie. Ajoutez-en un ci-dessous !
        </p>
    </div>
{% endif %}

<hr style="margin: 40px 0;">

{# Formulaire pour ajouter un joker #}
<h2>➕ Ajouter un Joker</h2>

{% if partie.availableJokerSlots <= 0 %}
    <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 15px 0; border-radius: 5px;">
        <strong>⚠️ Limite de slots atteinte !</strong><br>
        <p style="margin: 10px 0;">
            Vous avez {{ partie.jokers|length }} jokers sur {{ partie.totalJokerSlots }} slots disponibles.<br>
            Pour ajouter plus de jokers :
        </p>
        <ul style="margin: 5px 0 0 20px;">
            <li>Utilisez les boutons <strong>+1</strong> dans la carte "Slots Jokers" ci-dessus pour augmenter la limite</li>
            <li><strong>OU</strong> ajoutez un joker avec l'état <strong>Négatif ⚫</strong> (augmente automatiquement la limite de +1)</li>
        </ul>
    </div>
{% else %}
    <div style="background-color: #d4edda; border-left: 4px solid #28a745; padding: 10px 15px; margin: 15px 0; border-radius: 5px;">
        <strong>✅ Slots disponibles :</strong> {{ partie.availableJokerSlots }} slot(s) libre(s)
    </div>
{% endif %}

<div style="background-color: #f5f5f5; padding: 25px; border-radius: 10px; margin: 20px 0;">
        {# Barre de recherche de joker #}
        <div style="margin-bottom: 20px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">
                🔍 Rechercher un Joker
            </label>
            <input type="text" 
                   id="joker-search" 
                   placeholder="Tapez le nom d'un joker (ex: Vampire, Baron, Fibonacci...)"
                   style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 5px; font-size: 1em;"
                   autocomplete="off">
        </div>
        
        {# Résultats de recherche #}
        <div id="search-results" style="margin-bottom: 20px; display: none;">
            <h3 style="font-size: 1em; margin-bottom: 10px;">Résultats :</h3>
            <div id="results-container"></div>
        </div>
        
        {# Formulaire caché par défaut, affiché quand un joker est sélectionné #}
        <div id="joker-form" style="display: none;">
            <h3 style="margin-bottom: 15px;">Configuration du joker : <span id="selected-joker-name" style="color: #007bff;"></span></h3>
            
            <form method="post" action="{{ path('partie_show', {'id': partie.id}) }}">
                <input type="hidden" name="joker_instance[jokerTemplate]" id="selected-joker-id">
                <input type="hidden" name="joker_instance[_token]" value="{{ csrf_token('joker_instance') }}">
                
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label style="font-weight: bold; margin-bottom: 5px; display: block;">État (optionnel)</label>
                        <select name="joker_instance[etat]" class="form-control">
                            <option value="">Normal (aucun effet)</option>
                            <option value="foil">Foil ✨</option>
                            <option value="holographique">Holographique 💎</option>
                            <option value="polychrome">Polychrome 🌈</option>
                            <option value="negatif">Négatif ⚫</option>
                        </select>
                        <small style="color: #666; font-size: 0.9em;">Les états spéciaux donnent des bonus supplémentaires</small>
                    </div>
                    
                    <div>
                        <label style="font-weight: bold; margin-bottom: 5px; display: block;">Position (1-{{ partie.totalJokerSlots }})</label>
                        <input type="number" 
                               name="joker_instance[ordre]" 
                               value="{% if partie.jokers|length + 1 <= partie.totalJokerSlots %}{{ partie.jokers|length + 1 }}{% else %}{{ partie.totalJokerSlots }}{% endif %}" 
                               min="1" 
                               max="{{ partie.totalJokerSlots }}" 
                               class="form-control"
                               required>
                        <small style="color: #666; font-size: 0.9em;">Position du joker dans votre rangée (1 à {{ partie.totalJokerSlots }})</small>
                    </div>
                    
                    <div id="stack-field" style="display: none;">
                        <label style="font-weight: bold; margin-bottom: 5px; display: block;">Stacks de départ</label>
                        <input type="number" 
                               name="joker_instance[compteurStack]" 
                               value="0" 
                               min="0" 
                               class="form-control">
                        <small style="color: #666; font-size: 0.9em;">Nombre de stacks accumulés (généralement 0 au départ)</small>
                    </div>
                </div>
                
                <button type="submit" style="background-color: #28a745; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 1em;">
                    ✅ Ajouter le Joker
                </button>
                <button type="button" onclick="cancelJokerSelection()" style="background-color: #6c757d; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 1em; margin-left: 10px;">
                    ❌ Annuler
                </button>
            </form>
        </div>
    </div>
    
    <script>
    let selectedJokerData = null;
    
    // Recherche de jokers
    document.getElementById('joker-search').addEventListener('input', async function(e) {
        const query = e.target.value.trim();
        const resultsDiv = document.getElementById('search-results');
        const resultsContainer = document.getElementById('results-container');
        
        if (query.length < 2) {
            resultsDiv.style.display = 'none';
            return;
        }
        
        try {
            const response = await fetch(`{{ path('api_jokers_search') }}?q=${encodeURIComponent(query)}`);
            const jokers = await response.json();
            
            if (jokers.length === 0) {
                resultsContainer.innerHTML = '<p style="color: #666;">Aucun joker trouvé.</p>';
            } else {
                let html = '<div style="display: grid; gap: 10px;">';
                jokers.forEach(joker => {
                    const rareteColors = {
                        'commun': '#6c757d',
                        'uncommun': '#28a745',
                        'rare': '#007bff',
                        'legendary': '#ffc107'
                    };
                    const typeIcons = {
                        'chips': '🪙',
                        'mult_flat': '✖️',
                        'mult_multiplicateur': '📈',
                        'xmult': '💥'
                    };
                    
                    html += `
                        <div class="joker-result-card" 
                             data-joker-id="${joker.id}"
                             data-joker-nom="${joker.nom}"
                             data-joker-rarete="${joker.rarete}"
                             data-joker-description="${joker.description}"
                             data-joker-typestack="${joker.typeStack}"
                             data-joker-stackparunite="${joker.stackParUnite}"
                             style="border: 2px solid #ddd; padding: 15px; border-radius: 5px; cursor: pointer; background-color: white; transition: all 0.2s;"
                             onmouseover="this.style.borderColor='#007bff'; this.style.backgroundColor='#f8f9fa';"
                             onmouseout="this.style.borderColor='#ddd'; this.style.backgroundColor='white';">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <h4 style="margin: 0; color: #333;">${joker.nom}</h4>
                                <span style="background-color: ${rareteColors[joker.rarete]}; color: white; padding: 3px 8px; border-radius: 3px; font-size: 0.85em;">
                                    ${joker.rarete.toUpperCase()}
                                </span>
                            </div>
                            <p style="margin: 10px 0 5px 0; font-size: 0.9em; color: #666; font-style: italic;">
                                ${joker.description}
                            </p>
                            ${joker.typeStack !== 'none' ? `
                                <p style="margin: 5px 0 0 0; font-size: 0.85em; color: #17a2b8;">
                                    ${typeIcons[joker.typeStack]} ${joker.typeStack} (${joker.stackParUnite} par stack)
                                </p>
                            ` : `
                                <p style="margin: 5px 0 0 0; font-size: 0.85em; color: #007bff;">
                                    ⚡ Effet conditionnel
                                </p>
                            `}
                        </div>
                    `;
                });
                html += '</div>';
                resultsContainer.innerHTML = html;
                
                // Ajouter les event listeners sur les cartes de résultats
                document.querySelectorAll('.joker-result-card').forEach(card => {
                    card.addEventListener('click', function() {
                        const joker = {
                            id: this.dataset.jokerId,
                            nom: this.dataset.jokerNom,
                            rarete: this.dataset.jokerRarete,
                            description: this.dataset.jokerDescription,
                            typeStack: this.dataset.jokerTypestack,
                            stackParUnite: this.dataset.jokerStackparunite
                        };
                        selectJoker(joker);
                    });
                });
            }
            
            resultsDiv.style.display = 'block';
        } catch (error) {
            console.error('Erreur lors de la recherche:', error);
            resultsContainer.innerHTML = '<p style="color: #dc3545;">Erreur lors de la recherche.</p>';
        }
    });
    
    // Sélection d'un joker
    function selectJoker(joker) {
        selectedJokerData = joker;
        document.getElementById('selected-joker-id').value = joker.id;
        document.getElementById('selected-joker-name').textContent = joker.nom;
        document.getElementById('joker-form').style.display = 'block';
        document.getElementById('search-results').style.display = 'none';
        document.getElementById('joker-search').value = '';
        
        // Afficher le champ stack seulement si le joker utilise un système de stacks
        const stackField = document.getElementById('stack-field');
        if (joker.typeStack !== 'none') {
            stackField.style.display = 'block';
        } else {
            stackField.style.display = 'none';
        }
        
        // Scroll vers le formulaire
        document.getElementById('joker-form').scrollIntoView({ behavior: 'smooth' });
    }
    
    // Annuler la sélection
    function cancelJokerSelection() {
        selectedJokerData = null;
        document.getElementById('joker-form').style.display = 'none';
        document.getElementById('joker-search').value = '';
        document.getElementById('search-results').style.display = 'none';
    }
    </script>
</div>

{% endblock %}

{# Page d'accueil publique du site (accessible sans être connecté) avec présentation du simulateur #}
{% extends "base.html.twig" %}

{% block title %}Bienvenue - BALATRO SIMULATOR{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="jumbotron text-center border p-5 rounded shadow-sm">
        <h1 class="display-4">BALATRO SIMULATOR</h1>
        <p class="lead">Simulateur de parties de Balatro - Gérez vos jokers, cartes et stratégies</p>
        <hr class="my-4">
        <p>
            Bienvenue sur le simulateur Balatro ! Créez et gérez vos parties en ajoutant vos jokers favoris, 
            personnalisez votre deck de cartes, utilisez des consommables stratégiques et suivez l'évolution 
            de vos mains de poker. Sauvegardez vos sessions, exportez-les en JSON et reprenez vos parties 
            quand vous le souhaitez.
        </p>
    </div>

    <div class="row mt-5 text-center">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Gestion des Jokers</h5>
                    <p class="card-text">Ajoutez et gérez vos jokers avec leurs effets</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Deck Builder</h5>
                    <p class="card-text">Créez et personnalisez votre deck de cartes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Consommables</h5>
                    <p class="card-text">Tarots, Planètes et Spectres</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Hand Levels</h5>
                    <p class="card-text">Améliorez vos mains de poker</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Inscription - BALATRO SIMULATOR{% endblock %}

{% block body %}
<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px;">
    
    <div style="background-color: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); max-width: 450px; width: 100%;">
        
        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="margin: 0; color: #667eea;">Inscription</h1>
            <p style="color: #666; margin: 10px 0 0 0;">Créez votre compte gratuitement</p>
        </div>

        {% if errors is defined and errors|length > 0 %}
            <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                <strong>Erreurs :</strong>
                <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post">
            <div style="margin-bottom: 20px;">
                <label for="username" style="display: block; font-weight: bold; margin-bottom: 8px; color: #333;">
                    Nom d'utilisateur <span style="color: #dc3545;">*</span>
                </label>
                <input type="text" 
                       id="username" 
                       name="username" 
                       value="{{ username|default('') }}" 
                       required
                       minlength="3"
                       maxlength="50"
                       autofocus
                       style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 1em; box-sizing: border-box;"
                       placeholder="Minimum 3 caractères">
                <small style="color: #666; font-size: 0.85em;">Ce nom sera visible publiquement</small>
            </div>

            <div style="margin-bottom: 20px;">
                <label for="password" style="display: block; font-weight: bold; margin-bottom: 8px; color: #333;">
                    Mot de passe <span style="color: #dc3545;">*</span>
                </label>
                <input type="password" 
                       id="password" 
                       name="password" 
                       required
                       minlength="6"
                       style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 1em; box-sizing: border-box;"
                       placeholder="Minimum 6 caractères">
            </div>

            <div style="margin-bottom: 20px;">
                <label for="password_confirm" style="display: block; font-weight: bold; margin-bottom: 8px; color: #333;">
                    Confirmer le mot de passe <span style="color: #dc3545;">*</span>
                </label>
                <input type="password" 
                       id="password_confirm" 
                       name="password_confirm" 
                       required
                       minlength="6"
                       style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 1em; box-sizing: border-box;"
                       placeholder="Retapez votre mot de passe">
            </div>

            <button type="submit" 
                    style="width: 100%; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 15px; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; cursor: pointer; transition: transform 0.2s;"
                    onmouseover="this.style.transform='translateY(-2px)'"
                    onmouseout="this.style.transform='translateY(0)'">
                Créer mon compte
            </button>
        </form>

        <hr style="margin: 30px 0; border: none; border-top: 1px solid #ddd;">

        <div style="text-align: center;">
            <p style="color: #666; margin: 0 0 15px 0;">Vous avez déjà un compte ?</p>
            <a href="{{ path('app_login') }}" 
               style="display: inline-block; background-color: #667eea; color: white; padding: 12px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; transition: transform 0.2s;"
               onmouseover="this.style.transform='translateY(-2px)'"
               onmouseout="this.style.transform='translateY(0)'">
                Se connecter
            </a>
        </div>

        <div style="text-align: center; margin-top: 20px;">
            <a href="{{ path('app_home') }}" style="color: #667eea; text-decoration: none;">
                ← Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Bienvenue - BALATRO SIMULATOR{% endblock %}

{% block body %}
<div style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px;">
    
    <div style="text-align: center; color: white; margin-bottom: 50px;">
        <h1 style="font-size: 4em; margin: 0; text-shadow: 2px 2px 10px rgba(0,0,0,0.3);">
            BALATRO SIMULATOR
        </h1>
        <p style="font-size: 1.5em; margin: 20px 0; opacity: 0.9;">
            Simulateur de parties de Balatro - Gérez vos jokers, cartes et stratégies
        </p>
    </div>

    <div style="display: flex; gap: 30px; flex-wrap: wrap; justify-content: center;">
        <a href="{{ path('app_login') }}" 
           style="background-color: white; color: #667eea; padding: 20px 40px; border-radius: 10px; text-decoration: none; font-size: 1.3em; font-weight: bold; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s;"
           onmouseover="this.style.transform='translateY(-5px)'"
           onmouseout="this.style.transform='translateY(0)'">
            Se connecter
        </a>
        
        <a href="{{ path('app_register') }}" 
           style="background-color: #28a745; color: white; padding: 20px 40px; border-radius: 10px; text-decoration: none; font-size: 1.3em; font-weight: bold; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s;"
           onmouseover="this.style.transform='translateY(-5px)'"
           onmouseout="this.style.transform='translateY(0)'">
            Créer un compte
        </a>
    </div>

    <div style="margin-top: 80px; color: white; text-align: center; max-width: 800px;">
        <h2 style="margin-bottom: 30px;">Fonctionnalités</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div style="background-color: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; backdrop-filter: blur(10px);">
                <strong>Gestion des Jokers</strong>
                <p style="font-size: 0.9em; opacity: 0.8; margin: 10px 0 0 0;">Ajoutez et gérez vos jokers avec leurs effets</p>
            </div>
            <div style="background-color: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; backdrop-filter: blur(10px);">

                <strong>Deck Builder</strong>
                <p style="font-size: 0.9em; opacity: 0.8; margin: 10px 0 0 0;">Créez et personnalisez votre deck de cartes</p>
            </div>
            <div style="background-color: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; backdrop-filter: blur(10px);">
                <strong>Consommables</strong>
                <p style="font-size: 0.9em; opacity: 0.8; margin: 10px 0 0 0;">Tarots, Planètes et Spectres</p>
            </div>
            <div style="background-color: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; backdrop-filter: blur(10px);">
                <strong>Hand Levels</strong>
                <p style="font-size: 0.9em; opacity: 0.8; margin: 10px 0 0 0;">Améliorez vos mains de poker</p>
            </div>
        </div>
    </div>

    <div style="margin-top: 50px; color: white; font-size: 0.9em; opacity: 0.7;">
        <p>Créé avec Symfony 8.0 • Projet éducatif</p>
    </div>
</div>
{% endblock %}

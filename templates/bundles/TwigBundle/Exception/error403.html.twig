{% extends 'base.html.twig' %}

{% block title %}Accès refusé - 403{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-template">
                <h1 class="display-1 text-danger">403</h1>
                <h2 class="mb-4">Accès refusé</h2>
                <div class="error-details mb-4">
                    <p class="lead">Vous n'avez pas l'autorisation d'accéder à cette ressource.</p>
                    {% if not app.user %}
                        <p class="text-muted">Vous devez être connecté pour accéder à cette page.</p>
                    {% endif %}
                </div>
                <div class="error-actions">
                    {% if not app.user %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg me-2">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </a>
                    {% endif %}
                    <a href="{{ path('app_home') }}" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
